{
  "expo": {
    "name": "Freshly LB",
    "slug": "frischly-lebanon",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/images1/icon.png",
    "scheme": "frischlylebanon",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.frischly.lebanon",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "Freshly LB uses your microphone so you can search for products by voice."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images1/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.INTERNET"
      ],
      "package": "com.frischly.lebanon",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images1/favicon.png"
    },
    "plugins": [
      "expo-dev-client",
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images1/splash-icon.png",
          "resizeMode": "contain"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Freshly LB uses your microphone so you can search for products by voice."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Freshly LB uses your location to automatically fill in your city and set your exact delivery pin on the map."
        }
      ],
      "expo-font",
      "expo-video",
      "expo-web-browser",
      "expo-asset",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "color": "#f4bb26"
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.458731998907-3vchbl8i0ik78688o6i3edlv67n4lfos"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "extraPods": [
              { "name": "GoogleUtilities", "modular_headers": true },
              { "name": "RecaptchaInterop", "modular_headers": true },
              { "name": "AppCheckCore", "modular_headers": true }
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "90c8e0db-92c0-4a60-bfb1-32622e30dab0"
      }
    },
    "owner": "alihadimedlej001"
  }
}
